{
  "version": 2,
  "functions": {
    "api/**/*.js": { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    {
      "src": "/appcast.xml",
      "dest": "/appcast.xml",
      "headers": { "Content-Type": "application/rss+xml; charset=utf-8" }
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
