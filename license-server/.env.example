# CorrectMe License Server — Environment Variables
# Copy this to .env.local for local development (never commit .env.local)
# Add all these as Vercel Environment Variables in the Vercel Dashboard.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...      # Create a one-time price in Stripe Products

# Resend email (https://resend.com) — 3000 free emails/month
RESEND_API_KEY=re_...

# App config
SITE_URL=https://correctme.app
EMAIL_FROM=CorrectMe <license@correctme.app>

# IMPORTANT: Must match Sources/LicenseManager.swift → LICENSE_SECRET
# Generate: openssl rand -hex 32
LICENSE_SECRET=your_random_32_byte_secret_here
